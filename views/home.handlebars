<h1>Welcome</h1>
<h1>Products</h1>

<form action="/products" method="GET">
    <input type="search" name="q" value="{{term}}" placeholder="Search products, brands...">
    <select name="category">
        <option value="">All categories</option>
        {{#each categories}}
        <option value="{{id}}" {{#if (eq id ../categoryId)}}selected{{/if}}>{{name}}</option>
        {{/each}}
    </select>
    <button type="submit">Search</button>
</form>

{{#if products.length}}
<ul>
    {{#each products}}
    <li>
        {{#if imageUrl}}<img src="{{imageUrl}}" alt="{{name}}" width="120">{{/if}}
        <h3>{{name}}</h3>
        <p>{{brand}} | {{category}}</p>
        <p>{{description}}</p>
        <p>{{formatPrice price}} | {{stockText quantity}}</p>
    </li>
    {{/each}}
</ul>
{{else}}
<p>No products found.</p>
{{/if}}