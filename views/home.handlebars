<section class="product-page">

  
    <div class="product-heading">
        <div>
            <h1>Find Your Products</h1>
            <p>Browse products and check their prices and availability in store.</p>
        </div>
    </div>

   
    <form action="/products" method="GET" class="product-search" data-live-search>

        <div class="search-input">
            <i class="bi bi-search"></i>
            <input
                type="search"
                name="q"
                value="{{term}}"
                placeholder="Search by product name..."
                aria-label="Search products">
        </div>

        <div class="category-select">
            <i class="bi bi-grid"></i>
            <select name="category" aria-label="Filter by category">
                <option value="">All Categories</option>

                {{#each categories}}
                    <option value="{{id}}"
                        {{#if (eq id ../categoryId)}}selected{{/if}}>
                        {{name}}
                    </option>
                {{/each}}
            </select>
        </div>

    </form>

  
    <div class="product-section">

        <div class="product-section-heading">
            <h2>Our Products</h2>
            <span data-product-count>{{products.length}} products</span>
        </div>

        <div data-product-list aria-live="polite">
        {{#if products.length}}

            <div class="product-grid">

                {{#each products}}

                    <article class="product-card">

                        <div class="product-image">
                            {{#if imageUrl}}
                                <img src="{{imageUrl}}" alt="{{name}}" loading="lazy">
                            {{else}}
                                <div class="image-placeholder">
                                    <i class="bi bi-image"></i>
                                    <span>No Image Available</span>
                                </div>
                            {{/if}}
                        </div>

                        <div class="product-details">
                                <h3>Name: {{name}}</h3>

                            <p class="product-brand">Brand: {{brand}}</p>

                          
                            <p class="product-code">
                                Product Code: {{code}}
                            </p>

                            {{#if description}}
                                <p class="product-description">
                                   Description: {{description}}
                                </p>
                            {{/if}}

                            <div class="product-meta">
                                <span class="product-category">
                                   Category: {{category}}
                                </span>
                            </div>

                            <div class="product-footer">

                                <div class="product-price">
                                   {{formatPrice price}}
                                </div> 

                                <span class="stock-status">
                                    {{stockText quantity}}
                                </span>

                            </div>

                        </div>

                    </article>

                {{/each}}

            </div>

        {{else}}

            <div class="empty-products">
              
                <h3>No products found</h3>
                <p>
                    {{#if term}}
                        We couldn't find any products matching "{{term}}".
                        Try another search.
                    {{else}}
                        There are currently no products available.
                    {{/if}}
                </p>
            </div>

        {{/if}}
        </div>

    </div>


</section>
