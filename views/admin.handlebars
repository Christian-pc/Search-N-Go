<div class="admin-header">
    <h1>Manage products</h1>
    <a class="button-link" href="/admin/products/new">+ Add product</a>
</div>

<div class="table-wrap">
    <table class="admin-table">
        <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Brand</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {{#each products}}
            <tr>
                <td>{{ProductCode}}</td>
                <td><a href="/product/{{ProductId}}">{{ProductName}}</a></td>
                <td>{{BrandName}}</td>
                <td>{{CategoryName}}</td>
                <td>{{formatPrice Price}}</td>
                <td><span class="stock {{#unless QuantityAvailable}}out{{/unless}}">{{stockText QuantityAvailable}}</span></td>
                <td><a href="/admin/products/{{ProductId}}/edit">Edit</a></td>
            </tr>
        {{else}}
            <tr><td colspan="7" class="empty">No products yet.</td></tr>
        {{/each}}
        </tbody>
    </table>
</div>